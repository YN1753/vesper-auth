# Copy to /etc/vesper-auth/vesper-auth.env (chmod 600, owned by root:vesper-auth)

AUTH_ISSUER=https://auth.starryheavens.uk
AUTH_LISTEN=127.0.0.1:8090
AUTH_DB_PATH=/opt/vesper-auth/data/auth.db

# Optional: WebAuthn Relying Party overrides (defaults derived from AUTH_ISSUER)
# AUTH_RP_ID=auth.starryheavens.uk
# AUTH_RP_DISPLAY_NAME=Vesper Auth
# AUTH_RP_ORIGINS=https://auth.starryheavens.uk

# Optional first-boot admin bootstrap.
# Leave AUTH_ADMIN_PASSWORD unset to initialize via /setup in the browser on first launch.
AUTH_ADMIN_USER=admin
AUTH_ADMIN_EMAIL=admin@starryheavens.uk
# AUTH_ADMIN_PASSWORD=replace-with-strong-master-password

# Optional token / session lifetimes and rate-limit tuning
# AUTH_SESSION_TTL=168h
# AUTH_ACCESS_TOKEN_TTL=1h
# AUTH_ID_TOKEN_TTL=1h
# AUTH_REFRESH_TOKEN_TTL=720h
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW=10m
# AUTH_RATE_LIMIT_LOCKOUT=15m
